{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 240,
  "config": {
    "font": "Helvetica, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "grid": false
    }
  },
  "data": {
    "url": "data/six_year_by_group.csv"
  },
  "transform": [
    {
      "filter": "indexof(['First Nations','Not Indigenous','Low SES','Medium SES','High SES'],datum.group)>=0 && datum.cohort_start==2017"
    }
  ],
  "encoding": {
    "y": {
      "field": "group",
      "type": "nominal",
      "sort": [
        "First Nations",
        "Not Indigenous",
        "Low SES",
        "Medium SES",
        "High SES"
      ],
      "title": null
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#9aa5b1"
      },
      "encoding": {
        "x": {
          "field": "completed",
          "type": "quantitative",
          "title": "Completed within 6 years (%)",
          "scale": {
            "domain": [
              0,
              100
            ],
            "zero": true
          }
        },
        "x2": {
          "datum": 0
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 90,
        "color": "#1f5fa8"
      },
      "encoding": {
        "x": {
          "field": "completed",
          "type": "quantitative",
          "title": "Completed within 6 years (%)",
          "scale": {
            "domain": [
              0,
              100
            ],
            "zero": true
          }
        },
        "tooltip": [
          {
            "field": "group"
          },
          {
            "field": "completed",
            "title": "%"
          }
        ]
      }
    }
  ]
}